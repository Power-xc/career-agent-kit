#!/usr/bin/env bash
# 엔진 위치는 이 파일의 실제 경로로 정한다 (작업 폴더에서는 심볼릭 링크로 들어온다).
set -eu
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ENGINE="$(cd -P "$(dirname "$src")/.." && pwd)"
if [ -n "${HARNESS_PYTHON:-}" ]; then py="$HARNESS_PYTHON"
elif [ -x "$ENGINE/.venv/bin/python" ]; then py="$ENGINE/.venv/bin/python"
else py=python3; fi
export PYTHONPATH="$ENGINE${PYTHONPATH:+:$PYTHONPATH}"
if ! "$py" -c 'import harness.cli' >/dev/null 2>&1; then
  echo "하네스를 불러올 수 없습니다. 엔진 폴더($ENGINE)에서 python3 -m venv .venv && .venv/bin/pip install -e . 를 실행하세요." >&2
  exit 2
fi
exec "$py" -m harness "$@"
